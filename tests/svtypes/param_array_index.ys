# Reads of unpacked parameter arrays initialized with assignment patterns:
# constant multi-dimensional indices fold (also inside generate-if
# conditions), a dynamic index lowers to one $shiftx over the flattened
# table, and a trailing packed part-select slices the element.
read_verilog -sv -formal <<EOT
module top(input logic [2:0] sel, input logic [1:0] j,
           output logic [7:0] o, output logic [3:0] o2,
           output logic [31:0] c0, c1, c2);
  localparam logic [7:0] RC [8] = '{8'h11, 8'h22, 8'h33, 8'h44, 8'h55, 8'h66, 8'h77, 8'h88};
  localparam int T [2][3] = '{'{1, 2, 3}, '{4, 5, 6}};
  logic [3:0] n;
  assign n = sel + 4'd1;
  assign o = RC[sel];
  assign o2 = RC[sel][7:4];
  assign c0 = T[1][2];
  for (genvar x = 0; x < 2; x++) begin : g
    localparam int K = T[x][1] % 2;
    if (K == 0) begin : even
      assign c1[x*16 +: 16] = 16'hbeef;
    end else begin : odd
      assign c1[x*16 +: 16] = 16'hcafe;
    end
  end
  assign c2 = (j < 2'd3) ? T[0][j] + T[1][j] : 32'd0;
  always_comb begin
    assert (o == {n, n});
    assert (o2 == n);
    assert (c0 == 32'd6);
    assert (c1 == 32'hcafe_beef);
    assert (c2 == ((j < 2'd3) ? 32'(j) * 2 + 5 : 32'd0));
  end
endmodule
EOT
prep -top top
chformal -lower
sat -verify -prove-asserts
