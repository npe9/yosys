# always_comb writes through an index that is a wire, but one whose
# value is fixed by parameters/genvars (OpenTitan prim_lfsr p_perm_check:
# `sbox_perm_test[sbox_in_indices[k]] = 1'b1` over a permutation).  The
# mux tree cannot see that every bit is written, so proc_dlatch built a
# latch and strict mode refused it.  The enable (or'd with the async
# set/reset proc_dlatch splits off a constant write) is constant 1 under
# the module's combinational drivers: no storage, a connection.
read_verilog -sv -formal <<EOT
module top (input logic clk, input logic [3:0] d);
  logic [3:0][1:0] idx;
  for (genvar j = 0; j < 4; j++) begin : g
    assign idx[j] = 2'((j + 3) % 4);
  end
  logic [3:0] t, u;
  always_comb begin
    for (int k = 0; k < 4; k++) t[idx[k]] = 1'b1;
  end
  always_comb begin
    for (int k = 0; k < 4; k++) u[idx[k]] = d[k];
  end
  p_all: assert property (@(posedge clk) &t);
  p_perm: assert property (@(posedge clk) u == {d[0], d[3], d[2], d[1]});
endmodule
EOT
prep -top top
select -assert-none t:$dlatch t:$adlatch
sva2check
async2sync
logger -expect log "ic3: 2 properties: proved=2 disproved=0 undecided=0" 1
ic3
design -reset
logger -check-expected

# not a permutation: bits 2 and 3 really hold (reported from bit 2) -- still the strict error
logger -expect error "Latch inferred for signal `\\top.\\t \[2\]' from always_comb" 1
read_verilog -sv -formal <<EOT
module top (input logic clk);
  logic [3:0][1:0] idx;
  for (genvar j = 0; j < 4; j++) begin : g
    assign idx[j] = 2'(j / 2);
  end
  logic [3:0] t;
  always_comb begin
    for (int k = 0; k < 4; k++) t[idx[k]] = 1'b1;
  end
endmodule
EOT
prep -top top
