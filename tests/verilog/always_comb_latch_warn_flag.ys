# fe122: scratchpad proc_dlatch.always_comb_warn makes an always_comb latch
# a warning while the read stays strict; without the flag strict mode still
# errors.  fe155: the latch is built exactly, so the module is no longer
# marked sv_degraded; it is listed in (* sv_comb_latch *) instead
read_verilog -sv <<EOT
module top(input en, input [3:0] d, output logic [3:0] q);
  always_comb if (en) q = d;
endmodule
EOT
scratchpad -set proc_dlatch.always_comb_warn 1
logger -expect warning "Latch inferred for signal `\\top.\\q' from always_comb" 1
proc
select -assert-count 1 t:$dlatch
select -assert-none A:sv_degraded
select -assert-mod-count 1 A:sv_comb_latch
logger -check-expected
design -reset
scratchpad -unset proc_dlatch.always_comb_warn

read_verilog -sv <<EOT
module top(input en, input [3:0] d, output logic [3:0] q);
  always_comb if (en) q = d;
endmodule
EOT
logger -expect error "Latch inferred for signal `\\top.\\q' from always_comb" 1
proc
