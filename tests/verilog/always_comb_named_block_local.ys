# A local of a named block in always_comb, always written before it is read:
# nothing holds, so no latch (OpenTitan i3c_controller_fsm).
read_verilog -sv <<EOT
module top(input logic s, input logic [2:0] d, output logic [2:0] o, output logic [2:0] q);
  always_comb begin : g
    if (s) begin : b
      bit [2:0] left;
      left = d;
      o = left + 3'd1;
    end else o = 3'd0;
  end
  // loop copies of a named block
  always_comb begin
    q = '0;
    for (int i = 0; i < 2; i++) begin : l
      logic t;
      t = s & d[i];
      q[i] = t;
    end
  end
endmodule
EOT
hierarchy -top top
proc
select -assert-none t:$dlatch
sat -verify -set s 1 -set d 3'd5 -prove o 3'd6 -prove q 3'b001
sat -verify -set s 0 -set d 3'd5 -prove o 3'd0 -prove q 3'b000
design -reset

# Read before written in the block, the static local holds: still a latch
logger -expect error "Latch inferred for signal `.top\.\\g\.b\.left'" 1
read_verilog -sv <<EOT
module top(input logic s, input logic [2:0] d, output logic [2:0] o);
  always_comb begin : g
    o = 3'd0;
    if (s) begin : b
      bit [2:0] left;
      o = left;
      left = d;
    end
  end
endmodule
EOT
proc
logger -check-expected
design -reset

# Read from outside the block by its hierarchical name: still a latch
logger -expect error "Latch inferred for signal `.top\.\\g\.b\.left'" 1
read_verilog -sv <<EOT
module top(input logic s, input logic [2:0] d, output logic [2:0] o);
  always_comb begin : g
    if (s) begin : b
      bit [2:0] left;
      left = d;
    end
  end
  assign o = g.b.left;
endmodule
EOT
proc
logger -check-expected
