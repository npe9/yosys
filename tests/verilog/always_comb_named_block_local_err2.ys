# split from always_comb_named_block_local.ys: the expected error ends the script, so it is last

# Read from outside the block by its hierarchical name: still a latch
logger -expect error "Latch inferred for signal `.top\.\\g\.b\.left'" 1
read_verilog -sv <<EOT
module top(input logic s, input logic [2:0] d, output logic [2:0] o);
  always_comb begin : g
    if (s) begin : b
      bit [2:0] left;
      left = d;
    end
  end
  assign o = g.b.left;
endmodule
EOT
proc
logger -check-expected
