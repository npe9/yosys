# fe204: `#1step' clocking skews (IEEE 1800-2017 14.4; uvma_debug_if
# `input #1step debug_drv;').  It is the default input skew (14.3), so the
# model is the same as with no skew; `1' then the identifier `step' was read.
logger -expect warning "SVA temporal operators are parsed into" 1
logger -expect-no-warnings
read_verilog -sv -formal <<EOT
module top(input clk, input a, input b);
	clocking cb @(posedge clk);
		default input #1step;
		input #1step a;
		input b;
	endclocking
	assert property (@(posedge clk) cb.a |-> cb.b);
endmodule
EOT
logger -check-expected
hierarchy -top top
proc
opt_clean
rename top dut
write_rtlil clocking_1step_b.il
design -reset
read_verilog -sv -formal <<EOT
module top(input clk, input a, input b);
	clocking cb @(posedge clk);
		// (no default skew)
		input a;
		input b;
	endclocking
	assert property (@(posedge clk) cb.a |-> cb.b);
endmodule
EOT
hierarchy -top top
proc
opt_clean
rename top dut
write_rtlil clocking_1step_a.il
!for f in clocking_1step_a clocking_1step_b; do grep -v -e '^autoidx' -e 'attribute' $f.il | sed -E 's/[$][0-9]+/$N/g' > $f.n; done; diff clocking_1step_a.n clocking_1step_b.n
!rm -f clocking_1step_a.il clocking_1step_b.il clocking_1step_a.n clocking_1step_b.n
