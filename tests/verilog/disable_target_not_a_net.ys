# The target of `disable NAME` names a block, not a net: under -noautowire a
# conditional disable got "Identifier `\b1' is implicitly declared" from the
# generate-scope renaming instead of the fork's own diagnostic.
# an unconditional exit, also inside a generate block, elaborates (-noautowire) and skips the rest
read_verilog -sv -noautowire <<EOT
module ue(input logic [1:0] i0, output logic [1:0] y, output logic [1:0] z);
  always_comb begin : b2
    y = 2'd1;
    disable b2;
    y = i0;
  end
  if (1) begin : g
    always_comb begin : b3
      z = 2'd2;
      disable b3;
      z = i0;
    end
  end
endmodule
EOT
proc
sat -set i0 3 -prove y 1 -prove z 2 -verify
design -reset
logger -expect error "disable that is not an unconditional exit of its named block" 1
read_verilog -sv -noautowire <<EOT
module top(input logic clk, input logic [1:0] i0, output logic [1:0] o);
  logic [1:0] r = 0;
  always @(posedge clk) begin : b1
    r <= 2'd1;
    if (i0 == 2'd2) disable b1;
    r <= i0;
  end
  assign o = r;
endmodule
EOT
