# A -formal module derived by hierarchy AFTER a later plain read_verilog
# must keep its assertions (2026-10-21: the read mode was global, the
# derive ran in the last read's mode, and every assertion folded to
# constant true -- a false proof).
read_verilog -sv -formal <<EOT
module chk #(parameter int N = 1) (input logic clk, input logic [3:0] a);
  ap: assert property (@(posedge clk) a != 4'd15 |=> a == 4'd0);
endmodule
module top (input logic clk, output logic [3:0] q);
  dut u_dut (.clk(clk), .q(q));
  chk #(.N(2)) u_chk (.clk(clk), .a(q));
endmodule
EOT
read_verilog <<EOT
module dut (input clk, output reg [3:0] q);
  always @(posedge clk) q <= q + 1;
endmodule
EOT
hierarchy -check -top top
select -assert-min 1 t:$sva
sva2check
select -assert-count 1 t:$check
select -assert-none t:$sva
