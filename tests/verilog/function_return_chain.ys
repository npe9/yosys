# fe110: early returns in an inlined function or task (non-constant
# arguments).  A return's case got the statements after it as a new
# default arm, whose own returns were not folded: in `if (a) return 1;
# if (b) return 2; return 3;` b's arm fell through to 3.  A case whose
# every arm returns after the folding is a return for its caller, or the
# caller kept its fall-through (`if (a) begin if (b) return 1; return 2;
# end return 3;` gave 3 for a && b).  Stock yosys has no `return`.
read_verilog -sv <<EOT
module gold (input logic [15:0] p, input logic [2:0] s, output logic [3:0] o1, o2, o3, o4, o5, o6);
  always_comb begin
    if (p[s]) o1 = 1; else if (p[s+1]) o1 = 2; else if (p[s+2]) o1 = 3; else o1 = 5;
    if (p[s]) o2 = p[s+1] ? 1 : 2; else o2 = 3;
    case (p[1:0]) 2'd0: o3 = 1; 2'd1: o3 = p[s] ? 2 : 6; default: o3 = p[s+1] ? 3 : 7; endcase
    if (p[s]) o4 = 1; else if (p[s+1]) o4 = 9; else o4 = 8 + (p[s+2] ? 2 : 3);
    if (p[s]) o5 = 1; else if (p[s+1]) o5 = 2; else o5 = 3;
    if (p[s]) o6 = 1; else if (p[s+1]) o6 = 2; else o6 = 3;
  end
endmodule
module gate (input logic [15:0] p, input logic [2:0] s, output logic [3:0] o1, o2, o3, o4, o5, o6);
  function automatic logic [3:0] f1(logic [2:0] e);
    if (p[e]) return 1; if (p[e+1]) return 2; if (p[e+2]) return 3; return 5;
  endfunction
  function automatic logic [3:0] f2(logic [2:0] e);
    if (p[e]) begin if (p[e+1]) return 1; return 2; end return 3;
  endfunction
  function automatic logic [3:0] f3(logic [2:0] e);
    case (p[1:0]) 2'd0: return 1; 2'd1: if (p[e]) return 2; default: if (p[e+1]) return 3; endcase
    if (p[1:0] == 1) return 6; return 7;
  endfunction
  function automatic logic [3:0] f4(logic [2:0] e);
    logic [3:0] r; r = 8; if (p[e]) return 1; if (p[e+1]) return r + 1; r = r + (p[e+2] ? 2 : 3); return r;
  endfunction
  function automatic logic [3:0] f5(logic [2:0] e);
    begin if (p[e]) return 1; end begin if (p[e+1]) return 2; end return 3;
  endfunction
  task automatic t6(input logic [2:0] e, output logic [3:0] r);
    r = 0; if (p[e]) begin r = 1; return; end if (p[e+1]) begin r = 2; return; end r = 3;
  endtask
  always_comb begin o1 = f1(s); o2 = f2(s); o3 = f3(s); o4 = f4(s); o5 = f5(s); t6(s, o6); end
endmodule
EOT
proc
opt_clean
equiv_make gold gate eq
hierarchy -top eq
equiv_simple
equiv_status -assert
design -reset

# fe111: a return nested in an arm that falls through (no loop): the case
# did not take the statements after it, so they ran on the return path
# too (`if (a) begin if (b) return 1; end return 2;` gave 2 for a && b)
read_verilog -sv <<EOT
module gold (input logic a, b, input logic [1:0] c, output logic [3:0] o1, o2, o3, o4);
  always_comb begin
    o1 = a && b ? 1 : 2;
    o2 = a && b ? 1 : 2;
    o3 = c == 2'd0 && b ? 1 : 2;
    o4 = a && b ? 1 : (a ? 3 : 2);
  end
endmodule
module gate (input logic a, b, input logic [1:0] c, output logic [3:0] o1, o2, o3, o4);
  function automatic logic [3:0] f1(logic x); if (x) begin if (b) return 1; end return 2; endfunction
  function automatic logic [3:0] f2(logic x); if (x) if (b) return 1; return 2; endfunction
  function automatic logic [3:0] f3(logic [1:0] x); case (x) 2'd0: if (b) return 1; endcase return 2; endfunction
  function automatic logic [3:0] f4(logic x);
    logic [3:0] r; r = 2; if (x) begin r = 3; if (b) return 1; end return r;
  endfunction
  always_comb begin o1 = f1(a); o2 = f2(a); o3 = f3(c); o4 = f4(a); end
endmodule
EOT
proc
opt_clean
equiv_make gold gate eq
hierarchy -top eq
equiv_simple
equiv_status -assert
