# split from function_return_loop.ys: the expected error ends the script, so it is last

# shapes the per-iteration folding does not cover stay errors
logger -expect error "Function `f' has a return inside a nested loop \(not supported\)" 1
read_verilog -sv <<EOT
module nested (input logic [15:0] p, input logic [2:0] s, output logic [3:0] o);
  function automatic logic [3:0] f(logic [2:0] e);
    for (int i = 0; i < 2; i++) for (int j = 0; j < 2; j++) if (p[e+i*2+j]) return i*2+j;
    return 4'hf;
  endfunction
  always_comb o = f(s);
endmodule
EOT
