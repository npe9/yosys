  bind csr: core_i.cs_i chk k(.clk, .ra, .we, .wa, .wd, .rd, .c(core_i.cs_i.q));
`else
  chk k(.clk, .ra, .we, .wa, .wd, .rd, .c(`REF));
`endif
`ifdef MIXED
  // also read with a constant index through the same name: stays degraded
  m: assert property (@(posedge clk) core_i.cs_i.q[1] == core_i.cs_i.q[1]);
`endif
endmodule
EOT
hierarchy -top top
proc
flatten
select -assert-any A:sv_degraded=*implicitly?declared*
design -reset

# degraded: a kept 2-D unpacked memory
read_verilog -sv -formal -DTWOD <<EOT
// fe196 reject shapes, kept memories: TWOD unpacked [2][3]; ASCE elements [0:7]
module csr(input logic clk, input logic [1:0] ra, input logic we, input logic [1:0] wa, input logic [7:0] wd, output logic [7:0] rd);
`ifdef TWOD
  logic [7:0] q [2][3];
  always_ff @(posedge clk) if (we) q[wa[0]][wa] <= wd;
  assign rd = q[ra[0]][ra];
`else
  logic [0:7] q [4];
  always_ff @(posedge clk) if (we) q[wa] <= wd;
  assign rd = q[ra];
`endif
endmodule
module top(input logic clk, input logic [1:0] ra, input logic we, input logic [1:0] wa, input logic [7:0] wd, output logic [7:0] rd);
  csr cs_i(.*);
`ifdef TWOD
  logic [7:0] c [2][3];
`else
  logic [0:7] c [4];
`endif
  assign c = cs_i.q;
`ifdef TWOD
  p: assert property (@(posedge clk) ra[0] == 1'b1 && ra == 2'd1 |-> rd == c[1][1]);
`else
  // c[k][0] is the msb of q[k] both ways
  p: assert property (@(posedge clk) rd == c[ra]);
  b: assert property (@(posedge clk) rd[0] == c[ra][0]);
  n: assert property (@(posedge clk) rd == c[0]);
`endif
endmodule
EOT
hierarchy -top top
proc
flatten
select -assert-any A:sv_degraded=*implicitly?declared*
design -reset

