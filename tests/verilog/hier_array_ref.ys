read_verilog -sv -formal -DASG <<EOT
module regs(input logic clk);
  logic [7:0] ad [2:0];
  logic [7:0] ao [3:1];
  logic [7:0] big [4096];
  always_comb begin
    ad[2] = 8'd22; ad[1] = 8'd21; ad[0] = 8'd20;
    ao[3] = 8'd33; ao[2] = 8'd32; ao[1] = 8'd31;
  end
  always_comb for (int i = 0; i < 4096; i++) big[i] = 8'(i);
endmodule
module core(input logic clk); regs regs_i(.clk); endmodule
module top(input logic clk, input logic [1:0] i);
  core core_i(.clk);
`ifdef DYN
  logic [1:0] j;
  assign j = (i == 0) ? 2'd1 : i;
  p: assert property (@(posedge clk) core_i.regs_i.ao[j] == 8'd30 + j);
  n: assert property (@(posedge clk) core_i.regs_i.ao[j] == 8'd34 - j);
`elsif ASG
  logic [7:0] w [0:2];
  logic [7:0] v [1:3];
  assign w = core_i.regs_i.ad;
  assign v = core_i.regs_i.ao;
  p: assert property (@(posedge clk) w[0] == 22 && w[2] == 20 && v[1] == 33 && v[3] == 31);
  n: assert property (@(posedge clk) w[0] == 20);
`elsif BIG
  logic [7:0] b [4096];
  assign b = core_i.regs_i.big;
  p: assert property (@(posedge clk) b[5] == 5);
`endif
endmodule
EOT
