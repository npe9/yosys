# degraded: no flatten (each element is not joined yet)
read_verilog -sv -formal -DJOIN <<EOT
typedef struct packed { logic l; logic [6:0] v; } cfg_t;
module regs(input logic clk, input logic [1:0] wa, input logic [7:0] wd);
  logic [7:0] an [3];
  logic [7:0] ad [2:0];
  logic [7:0] ao [3:1];
  cfg_t       cs [3];
  logic [0:7] ab [3];
  logic signed [7:0] sg [2];
  logic [7:0] m2 [2][3];
  always_comb begin
    an[0] = 8'd10; an[1] = 8'd11; an[2] = 8'd12;
    ad[2] = 8'd22; ad[1] = 8'd21; ad[0] = 8'd20;
    ao[3] = 8'd33; ao[2] = 8'd32; ao[1] = 8'd31;
    cs[0] = '{1'b1, 7'd5}; cs[1] = '{1'b0, 7'd6}; cs[2] = '{1'b1, 7'd7};
    ab[0] = 8'b0000_0001; ab[1] = 8'd2; ab[2] = 8'd3;
    sg[0] = -8'sd3; sg[1] = 8'sd4;
  end
  always_comb for (int i = 0; i < 2; i++) for (int j = 0; j < 3; j++) m2[i][j] = 8'(i * 3 + j);
  generate if (1) begin : g
    logic [3:0] ga [2];
    assign ga[0] = 4'd9; assign ga[1] = 4'd6;
  end endgenerate
  logic [7:0] rm [256];
  always_ff @(posedge clk) rm[wa] <= wd;
endmodule
module core(input logic clk, input logic [1:0] wa, input logic [7:0] wd); regs regs_i(.*); endmodule
module obs(input logic clk, input logic [7:0] pn [3], input logic [7:0] pd [2:0], input logic [7:0] po [3],
           input logic [7:0] pc [3], input logic [7:0] pb [3], input logic signed [7:0] ps [2], input logic [3:0] pg [1:0]);
  // left to right (1800-2017 7.6, 23.3.3): po[0] is ao[3], pg[1] is g.ga[0]
  p: assert property (@(posedge clk) pn[0] == 10 && pn[2] == 12 && pd[2] == 22 && pd[0] == 20
                       && po[0] == 33 && po[1] == 32 && po[2] == 31
                       && pc[0] == 8'h85 && pc[1] == 8'h06 && pc[2] == 8'h87 && pb[0] == 8'h01
                       && ps[0] < 0 && ps[1] > 0 && pg[1] == 9 && pg[0] == 6);
  n1: assert property (@(posedge clk) pn[0] == 12);
  n2: assert property (@(posedge clk) pd[2] == 20);
  n3: assert property (@(posedge clk) po[0] == 31);
  n4: assert property (@(posedge clk) pc[0] == 8'h87);
  n5: assert property (@(posedge clk) pg[1] == 6);
endmodule
module drv(output logic [7:0] q [3]); assign q[0] = 1; assign q[1] = 2; assign q[2] = 3; endmodule
module top(input logic clk, input logic [1:0] wa, input logic [7:0] wd);
  core core_i(.*);
`ifdef MIXED
  obs obs_i(.clk, .pn(core_i.regs_i.an), .pd(core_i.regs_i.ad), .po(core_i.regs_i.ao), .pc(core_i.regs_i.cs),
            .pb(core_i.regs_i.ab), .ps(core_i.regs_i.sg), .pg(core_i.regs_i.g.ga));
  m: assert property (@(posedge clk) core_i.regs_i.an[1] == 11);
`elsif DRIVE
  drv d(.q(core_i.regs_i.an));
`elsif MEM
  logic [7:0] w [256];
  assign w = core_i.regs_i.rm;
  q: assert property (@(posedge clk) w[3] == 0);
`elsif TWOD
  logic [7:0] x [2][3];
  assign x = core_i.regs_i.m2;
  q: assert property (@(posedge clk) x[1][2] == 5);
`else
  obs obs_i(.clk, .pn(core_i.regs_i.an), .pd(core_i.regs_i.ad), .po(core_i.regs_i.ao), .pc(core_i.regs_i.cs),
            .pb(core_i.regs_i.ab), .ps(core_i.regs_i.sg), .pg(core_i.regs_i.g.ga));
`endif
endmodule
EOT
