# fe191: an interface port connected to a hierarchical name of an interface
# instance (`.m(core_i.i)'; cv32e40s binds load_store_unit_sva with
# `.m_c_obi_data_if(core_i.m_c_obi_data_if)', core_i two scopes above the
# bind target) was an implicit 1-bit net: the port was never expanded and
# every member the sub-module read was a free wire.  hierarchy now finds the
# instance (downward, else upward by IEEE 1800-2017 23.8: the nearest scope
# holding the head) and connects each member the sub-module uses to a
# reference `path.member', which flatten joins (forwarding it upward when
# the instance is further up).  Until joined the module carries an
# sv_degraded reason.

# downward, one level: a packed-struct member (m.s.req) and a vector
logger -expect log "c.p: proved" 1
logger -expect log "c.n: disproved" 1
read_verilog -sv -formal -DV1 <<EOT
typedef struct packed { logic req; logic [1:0] k; } req_t;
interface ifc; req_t s; logic [3:0] a; modport mon(input s, a); modport mst(output s, a); endinterface
module lsu(input logic clk); endmodule
module chk(input logic clk, ifc.mon m);
  p: assert property (@(posedge clk) m.s.req == 1'b1 && m.a == 4'd9);
  n: assert property (@(posedge clk) m.a != 4'd9);
endmodule
module core(input logic clk);
  ifc i();
  assign i.s = '{req: 1'b1, k: 2'd2};
  assign i.a = 4'd9;
  lsu l(.clk(clk));
endmodule
module top(input logic clk);
  core core_i(.clk(clk));
  // V selects the variant
`ifdef V0  // local interface in top, direct instance
  ifc i0();
  assign i0.s = '{req: 1'b1, k: 2'd2};
  assign i0.a = 4'd9;
  chk c(.clk(clk), .m(i0));
`elsif V1  // direct instantiation in top, hierarchical interface connection one level down
  chk c(.clk(clk), .m(core_i.i));
`elsif V2  // bind into core, local interface instance
  bind core chk c(.clk(clk), .m(i));
`elsif V3  // bind into lsu, upward reference to the interface instance (cv32e40s shape)
  bind lsu chk c(.clk(clk), .m(core_i.i));
`endif
endmodule
EOT
hierarchy -top top
proc
flatten
select -assert-none A:sv_degraded
sva2check
async2sync
ic3 -check-cells -init-zero
logger -check-expected
design -reset

# upward, two scopes above the bind target (the cv32e40s shape)
logger -expect log "c.p: proved" 1
logger -expect log "c.n: disproved" 1
read_verilog -sv -formal -DV3 <<EOT
typedef struct packed { logic req; logic [1:0] k; } req_t;
interface ifc; req_t s; logic [3:0] a; modport mon(input s, a); modport mst(output s, a); endinterface
module lsu(input logic clk); endmodule
module chk(input logic clk, ifc.mon m);
  p: assert property (@(posedge clk) m.s.req == 1'b1 && m.a == 4'd9);
  n: assert property (@(posedge clk) m.a != 4'd9);
endmodule
module core(input logic clk);
  ifc i();
  assign i.s = '{req: 1'b1, k: 2'd2};
  assign i.a = 4'd9;
  lsu l(.clk(clk));
endmodule
module top(input logic clk);
  core core_i(.clk(clk));
  // V selects the variant
`ifdef V0  // local interface in top, direct instance
  ifc i0();
  assign i0.s = '{req: 1'b1, k: 2'd2};
  assign i0.a = 4'd9;
  chk c(.clk(clk), .m(i0));
`elsif V1  // direct instantiation in top, hierarchical interface connection one level down
  chk c(.clk(clk), .m(core_i.i));
`elsif V2  // bind into core, local interface instance
  bind core chk c(.clk(clk), .m(i));
`elsif V3  // bind into lsu, upward reference to the interface instance (cv32e40s shape)
  bind lsu chk c(.clk(clk), .m(core_i.i));
`endif
endmodule
EOT
hierarchy -top top
proc
