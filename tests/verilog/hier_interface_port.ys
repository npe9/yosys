# the nearest scope holding `core_i' wins (mid.core_i.i = 7, not top.core_i.i = 9)
logger -expect log "c.p: proved" 1
logger -expect log "c.n: disproved" 1
read_verilog -sv -formal -DA2 <<EOT
interface ifc #(parameter W = 4); logic [W-1:0] a; logic b; modport mon(input a, b); modport mon2(input a); modport mst(output a, b); endinterface
module lsu(input logic clk); endmodule
module chk #(parameter W = 4, parameter [W-1:0] V = 9) (input logic clk, ifc.mon m);
  p: assert property (@(posedge clk) m.a == V);
  n: assert property (@(posedge clk) m.a != V);
endmodule
module chk2(input logic clk, ifc.mon2 m);
  p: assert property (@(posedge clk) m.a == 4'd9);
endmodule
module drv(input logic clk, ifc.mst m);
  assign m.a = 4'd3;
  p: assert property (@(posedge clk) m.a == 4'd3);
endmodule
module core #(parameter W = 4, parameter [W-1:0] V = 9) (input logic clk);
  ifc #(.W(W)) i();
  assign i.a = V;
  assign i.b = 1'b0;
  lsu l(.clk(clk));
endmodule
module coreport(input logic clk, ifc.mst i);
  assign i.a = 4'd9;
  assign i.b = 1'b1;
  lsu l(.clk(clk));
endmodule
module lsu2(input logic clk); endmodule
module core2(input logic clk);
  ifc i();
  assign i.a = 4'd7;
  assign i.b = 1'b0;
  lsu2 l(.clk(clk));
endmodule
module mid(input logic clk);
  core2 core_i(.clk(clk));
endmodule
module top(input logic clk);
`ifdef A1   // not an interface instance: stays degraded
  core core_i(.clk(clk));
  bind lsu chk c(.clk(clk), .m(core_i.l));
`elsif A2   // nearest scope: mid.core_i.i (7), not top.core_i.i (9)
  core core_i(.clk(clk));
  mid m(.clk(clk));
  bind lsu2 chk #(.V(4'd7)) c(.clk(clk), .m(core_i.i));
`elsif A3   // parameterized interface, 8 bits
  core #(.W(8), .V(8'd200)) core_i(.clk(clk));
  bind lsu chk #(.W(8), .V(8'd200)) c(.clk(clk), .m(core_i.i));
`elsif A4   // downward miss: stays degraded
  core core_i(.clk(clk));
  bind lsu chk c(.clk(clk), .m(core_i.k));
`elsif A7   // narrower modport: a only
  core core_i(.clk(clk));
  bind lsu chk2 c(.clk(clk), .m(core_i.i));
`elsif A6   // a driver through the reference: second driver of i.a, upward -> stays degraded
  core core_i(.clk(clk));
  bind lsu drv c(.clk(clk), .m(core_i.i));
`elsif A9   // the instance is an interface port of core_i
  ifc ti();
  coreport core_i(.clk(clk), .i(ti));
  bind lsu chk c(.clk(clk), .m(core_i.i));
`endif
endmodule
EOT
hierarchy -top top
proc
flatten
select -assert-none A:sv_degraded
sva2check
async2sync
ic3 -check-cells -init-zero
logger -check-expected
design -reset

