# joined: a derived module with an interface port, whose AST carried the
# read-time "implicitly declared" entry over (dropped for the array)
logger -expect log "ic3: core_i.id_stage_i.h.p: proved" 1
logger -expect log "ic3: core_i.id_stage_i.h.n: disproved" 1
read_verilog -sv -formal <<EOT
// fe195: the bind target has an interface port (cv32e40s_id_stage$interfaces$if_xif)
interface xif; logic [3:0] v; endinterface
module ids #(parameter P = 1) (input logic clk, xif x);
endmodule
module helper(input logic clk, input logic [4:0] ra [2], input logic r);
  p: assert property (@(posedge clk) ra[0] == 5'd3 && ra[1] == 5'd17 && r);
  n: assert property (@(posedge clk) ra[0] != 5'd3 || ra[1] != 5'd17);
endmodule
module core(input logic clk);
  xif xi();
  logic [4:0] ra [2];
  logic re;
  assign ra[0] = 5'd3;
  assign ra[1] = 5'd17;
  assign re = 1'b1;
  assign xi.v = 4'd1;
  ids #(.P(2)) id_stage_i(.clk, .x(xi));
endmodule
module top(input logic clk);
  core core_i(.clk);
  bind ids: core_i.id_stage_i helper h(.clk, .ra(core_i.ra), .r(core_i.re));
endmodule
EOT
