// fe195: chains that disagree (two wrappers, core_i of different N)
module ids(input logic clk);
endmodule
module helper #(parameter N = 2) (input logic clk, input logic [4:0] ra [2]);
  p: assert property (@(posedge clk) ra[0] == 5'd3);
endmodule
module core #(parameter N = 2) (input logic clk);
  logic [4:0] ra [N];
  for (genvar k = 0; k < N; k++) begin : g
    assign ra[k] = 5'd3;
  end
  ids id_stage_i(.clk);
endmodule
module wrap #(parameter N = 2) (input logic clk);
  core #(.N(N)) core_i(.clk);
endmodule
module top(input logic clk);
  wrap #(.N(2)) w0(.clk);
  wrap #(.N(3)) w1(.clk);
  bind ids helper h(.clk, .ra(core_i.ra));
endmodule
EOT
