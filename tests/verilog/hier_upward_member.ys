# an interface port connected by a hierarchical name (fe191) next to a
# member slice with the same head in the bind target: the slice wire is
# no local generate scope, so the interface is still found upward
logger -expect log "c.p: proved" 1
logger -expect log "c.n: disproved" 1
read_verilog -sv -formal <<EOT
typedef struct packed { logic req; logic [1:0] k; } req_t;
interface ifc; req_t s; logic [3:0] a; modport mon(input s, a); endinterface
module lsu(input logic clk); endmodule
module chk(input logic clk, ifc.mon m, input logic [1:0] kk);
  p: assert property (@(posedge clk) m.s.req && m.a == 4'd9 && kk == 2'd2);
  n: assert property (@(posedge clk) m.a != 4'd9);
endmodule
module core(input logic clk);
  ifc i();
  req_t st;
  assign st = '{req: 1'b1, k: 2'd2};
  assign i.s = st;
  assign i.a = 4'd9;
  lsu l(.clk(clk));
endmodule
module top(input logic clk);
  core core_i(.clk(clk));
  bind lsu chk c(.clk(clk), .m(core_i.i), .kk(core_i.st.k));
endmodule
EOT
hierarchy -top top
proc
flatten
select -assert-none A:sv_degraded
sva2check
async2sync
ic3 -check-cells -init-zero
logger -check-expected
