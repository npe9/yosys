# fe192: a hierarchical reference whose head is an instance two or more
# scopes up (IEEE 1800-2017 23.8, fe190) and which ends in a member of a
# packed struct / union there (cv32e40s sleep_unit_sva:
# `wb_stage_i.ex_wb_pipe_i.instr.bus_resp.rdata'; the mpu_sva bind:
# `core_i.load_store_unit_i.write_buffer_i.trans_o.memtype[0]') was an
# implicit 1-bit wire.  The struct wire is now the reference (forwarded and
# joined by flatten) and the member its slice; constant bit selects of an
# upward reference no longer skip the upward search.
# a member two scopes up, one level down
logger -expect log "c.p: proved" 1
logger -expect log "c.n: disproved" 1
read_verilog -sv -formal -DPLAIN <<EOT
typedef struct packed { logic [3:0] rdata; logic err; } resp_t;
typedef struct packed { resp_t bus_resp; logic v; } instr_t;
typedef struct packed { logic v; resp_t bus_resp; } instr2_t;
typedef struct packed { logic [2:0] prot; logic [1:0] memtype; logic dbg; } req_t;
module wbuf(input logic clk); req_t trans_o; assign trans_o = '{prot: 3'd5, memtype: 2'b10, dbg: 1'b1}; endmodule
module wb(input logic clk, input instr_t pi); instr_t q; assign q = pi; logic [3:0] vec; assign vec = 4'b0101; wbuf wbuf_i(.clk); endmodule
module wb2(input logic clk, input instr2_t pi); endmodule
module sub(input logic clk); endmodule
module chk2(input logic clk);
`ifdef BOTH
  p: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata == 4'h9 && wb_stage_i.pi == 6'b1001_0_1 && wb_stage_i.pi.v);
  n: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata != 4'h9);
`elsif TWO
  p: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata == 4'h9 && !wb_stage_i.pi.bus_resp.err && wb_stage_i.q.v);
  n: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.err);
`elsif BIT
  p: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata[0] && wb_stage_i.pi.bus_resp.rdata[3] && !wb_stage_i.pi.bus_resp.rdata[1]);
  n: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata[2]);
`elsif DEEP
  p: assert property (@(posedge clk) wb_stage_i.wbuf_i.trans_o.memtype[1] && !wb_stage_i.wbuf_i.trans_o.memtype[0] && wb_stage_i.wbuf_i.trans_o.prot == 3'd5);
  n: assert property (@(posedge clk) wb_stage_i.wbuf_i.trans_o.memtype[0]);
`elsif VEC
  p: assert property (@(posedge clk) wb_stage_i.vec[0] && wb_stage_i.vec[2] && !wb_stage_i.vec[1]);
  n: assert property (@(posedge clk) wb_stage_i.vec[3]);
`elsif DRIVE
  assign wb_stage_i.q.v = 1'b0;
  p: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata == 4'h9);
`else
  p: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata == 4'h9);
  n: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata == 4'h8);
`endif
endmodule
module mid(input logic clk);
  instr_t p;
  assign p = '{bus_resp: '{rdata: 4'h9, err: 1'b0}, v: 1'b1};
`ifdef SWAP
  sub sub_i(.clk);
  wb wb_stage_i(.clk, .pi(p));
`else
  wb wb_stage_i(.clk, .pi(p));
  sub sub_i(.clk);
`endif
endmodule
module mid2(input logic clk);
  instr2_t p;
  assign p = '{bus_resp: '{rdata: 4'h9, err: 1'b0}, v: 1'b1};
  wb2 wb_stage_i(.clk, .pi(p));
  sub sub_i(.clk);
endmodule
module top(input logic clk);
  mid mid_i(.clk);
`ifdef DIS
  mid2 mid2_i(.clk);
`endif
  bind sub chk2 c(.clk);
endmodule
EOT
hierarchy -top top
proc
flatten
select -assert-none A:sv_degraded
sva2check
async2sync
ic3 -check-cells -init-zero
logger -check-expected
design -reset

