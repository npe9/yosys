module chk2(input logic clk);
`ifdef BOTH
  p: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata == 4'h9 && wb_stage_i.pi == 6'b1001_0_1 && wb_stage_i.pi.v);
  n: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata != 4'h9);
`elsif TWO
  p: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata == 4'h9 && !wb_stage_i.pi.bus_resp.err && wb_stage_i.q.v);
  n: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.err);
`elsif BIT
  p: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata[0] && wb_stage_i.pi.bus_resp.rdata[3] && !wb_stage_i.pi.bus_resp.rdata[1]);
  n: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata[2]);
`elsif DEEP
  p: assert property (@(posedge clk) wb_stage_i.wbuf_i.trans_o.memtype[1] && !wb_stage_i.wbuf_i.trans_o.memtype[0] && wb_stage_i.wbuf_i.trans_o.prot == 3'd5);
  n: assert property (@(posedge clk) wb_stage_i.wbuf_i.trans_o.memtype[0]);
`elsif VEC
  p: assert property (@(posedge clk) wb_stage_i.vec[0] && wb_stage_i.vec[2] && !wb_stage_i.vec[1]);
  n: assert property (@(posedge clk) wb_stage_i.vec[3]);
`elsif DRIVE
  assign wb_stage_i.q.v = 1'b0;
  p: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata == 4'h9);
`else
  p: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata == 4'h9);
  n: assert property (@(posedge clk) wb_stage_i.pi.bus_resp.rdata == 4'h8);
`endif
endmodule
module mid(input logic clk);
  instr_t p;
  assign p = '{bus_resp: '{rdata: 4'h9, err: 1'b0}, v: 1'b1};
`ifdef SWAP
  sub sub_i(.clk);
  wb wb_stage_i(.clk, .pi(p));
`else
  wb wb_stage_i(.clk, .pi(p));
  sub sub_i(.clk);
`endif
endmodule
module mid2(input logic clk);
  instr2_t p;
  assign p = '{bus_resp: '{rdata: 4'h9, err: 1'b0}, v: 1'b1};
  wb2 wb_stage_i(.clk, .pi(p));
  sub sub_i(.clk);
endmodule
module top(input logic clk);
  mid mid_i(.clk);
`ifdef DIS
  mid2 mid2_i(.clk);
`endif
  bind sub chk2 c(.clk);
endmodule
EOT
hierarchy -top top
proc
flatten
select -assert-none A:sv_degraded
sva2check
async2sync
