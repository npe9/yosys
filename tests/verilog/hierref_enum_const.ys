# A hierarchical reference that names an enum item (or a parameter) of an
# instance's module, not a wire (OpenTitan prim_alert_rxtx_assert_fpv:
# `prim_alert_rxtx_tb.i_prim_alert_receiver.state_q inside
# {prim_alert_rxtx_tb.i_prim_alert_receiver.InitReq, ...}'): it was a free
# implicit 1-bit net, and the design degraded.  It is now that constant, at
# its own width: downward, upward from a bound checker, and through it.
read_verilog -sv -formal <<EOT
module rx #(parameter int W = 3) (input logic [2:0] d, output logic [2:0] q);
  typedef enum logic [2:0] {Idle, Busy, InitReq = 3'd5, Done} state_e;
  state_e state_q;
  assign state_q = state_e'(d);
  assign q = d;
endmodule
module tb(input logic [2:0] d);
  rx #(.W(7)) u_rx(.d(d), .q());
  wire is_init = (u_rx.state_q == u_rx.InitReq);
  always_comb begin
    p_down: assert (is_init == (d == 3'd5));
    p_done: assert (u_rx.Done == 3'd6);
    p_par: assert (u_rx.W == 7);
  end
endmodule
module chk(input logic [2:0] d);
  always_comb begin
    p_up: assert ((tb.u_rx.state_q == tb.u_rx.Busy) == (d == 3'd1));
    n_up: assert (tb.u_rx.state_q != tb.u_rx.Idle);
  end
endmodule
bind tb chk u_chk(.d(d));
EOT
hierarchy -check -top tb
proc
flatten
select -assert-none A:sv_degraded
chformal -lower
design -save x
select -assert-count 1 tb/c:u_chk.n_up
delete tb/c:u_chk.n_up
sat -verify -prove-asserts tb
design -load x
delete tb/c:p_* tb/c:u_chk.p_*
sat -falsify -prove-asserts tb
