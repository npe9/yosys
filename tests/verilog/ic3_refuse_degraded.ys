# Register v3 B5: ic3 refuses a design whose modules carry sv_degraded /
# sv_permissive (the frontend's -permissive marks), printing the list first;
# -allow-degraded runs anyway.
logger -expect log "design carries sv_degraded" 1
logger -expect error "refusing a design that carries sv_degraded" 1
read_verilog -sv -formal -permissive <<EOT
`default_nettype none
module m(input wire clk, output wire y);
  assign y = undeclared_sig;
  p: assert property (@(posedge clk) y || !y);
endmodule
EOT
hierarchy -check -top m
sva2check
proc
async2sync
ic3 -check-cells -init-zero
