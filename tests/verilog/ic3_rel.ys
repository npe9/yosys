# relpred + ic3 -rel (SecIC3-style cross-copy predicates, RP-2).  A
# constant-time accumulator, self-composed: the secret operand differs, the
# public start agrees, and done must agree.  The predicates only observe,
# every replaced or swapped cube is checked, and a mislabelled predicate is
# caught by the seed checks.
read_verilog -sv -formal <<EOT
module acc(input clk, input start, input [7:0] s, output done, output [15:0] r);
  reg [3:0] cnt = 0;
  reg busy = 0;
  reg [15:0] a = 0;
  always @(posedge clk) begin
    if (start && !busy) begin busy <= 1; cnt <= 0; a <= 0; end
    else if (busy) begin
      a <= a + s;
      cnt <= cnt + 1;
      if (cnt == 9) busy <= 0;
    end
  end
  assign done = busy && cnt == 9;
  assign r = a;
endmodule
module top(input clk, input start, input [7:0] s1, input [7:0] s2);
  wire d1, d2;
  wire [15:0] r1, r2;
  acc copy1(.clk(clk), .start(start), .s(s1), .done(d1), .r(r1));
  acc copy2(.clk(clk), .start(start), .s(s2), .done(d2), .r(r2));
  always @* ct: assert (d1 == d2);
endmodule
EOT
prep -top top
flatten
dffunmap
opt_clean
design -save plain

# predicates on the register words in the property's cone (busy, cnt; the
# accumulator a feeds no output and opt_clean removed it)
logger -expect log "relpred: top: 2 mismatch predicates added" 1
relpred
logger -check-expected
select -assert-count 2 a:relpred_pair
design -save rel

logger -expect log "ct: proved .*\[certified\]" 1
logger -expect log "-rel ct: 2 words, 10 seed clauses \(0 dropped\)" 1
ic3 -init-zero -kind 0 -certify -rel -rel-sym
logger -check-expected

design -load rel
logger -expect log "ct: proved .*\[certified\]" 1
ic3 -init-zero -kind 0 -certify -rel-mode maximal
logger -check-expected

design -load rel
logger -expect log "ct: proved .*\[certified\]" 1
logger -expect log "replace 0/0, symmetric 0/0" 1
ic3 -init-zero -kind 0 -certify -rel-mode seed
logger -check-expected

# a predicate whose attribute names the wrong pair (neq of cnt labelled
# busy/busy): its seeds fail the checks and are dropped, replacement no
# longer fires on cubes with neq = 0 (it made a clause that did not block
# its cube, and block() looped forever: RP-2 hang), the verdict stands
design -load rel
setattr -set relpred_pair "copy1.busy copy2.busy" w:relpred_neq.cnt
design -save mis
logger -expect log "ct: proved" 1
logger -expect log "-rel ct: 2 words, 2 seed clauses \(2 dropped\)" 1
ic3 -init-zero -kind 0 -rel
logger -check-expected

design -load mis
logger -expect log "ct: proved .*\[certified\]" 1
logger -expect log "-rel ct: 2 words, 2 seed clauses \(2 dropped\)" 1
ic3 -init-zero -kind 0 -certify -rel -rel-sym
logger -check-expected

design -load mis
logger -expect log "ct: proved" 1
ic3 -init-zero -kind 0 -rel-mode maximal
logger -check-expected

design -load mis
logger -expect log "ct: proved" 1
logger -expect log "replace 0/0" 1
ic3 -init-zero -kind 0 -rel-mode seed -rel-sym
logger -check-expected

# the other direction: neq of busy labelled with the cnt words
design -load rel
setattr -set relpred_pair "copy1.cnt copy2.cnt" w:relpred_neq.busy
logger -expect log "ct: proved" 1
logger -expect log "-rel ct: 2 words, 8 seed clauses \(8 dropped\)" 1
ic3 -init-zero -kind 0 -rel -rel-sym
logger -check-expected

# leaky variant (the end condition reads the secret): still disproved
design -reset
read_verilog -sv -formal <<EOT
module acc(input clk, input start, input [7:0] s, output done);
  reg [3:0] cnt = 0;
  reg busy = 0;
  always @(posedge clk) begin
    if (start && !busy) begin busy <= 1; cnt <= 0; end
    else if (busy) begin
      cnt <= cnt + 1;
      if (cnt == 9 || (cnt == 3 && s[0])) busy <= 0;
    end
  end
  assign done = busy && (cnt == 9 || (cnt == 3 && s[0]));
endmodule
module top(input clk, input start, input [7:0] s1, input [7:0] s2);
  wire d1, d2;
  acc copy1(.clk(clk), .start(start), .s(s1), .done(d1));
  acc copy2(.clk(clk), .start(start), .s(s2), .done(d2));
  always @* ct: assert (d1 == d2);
endmodule
EOT
prep -top top
flatten
dffunmap
opt_clean
relpred
logger -expect log "ct: disproved" 1
ic3 -init-zero -kind 0 -rel -rel-sym
logger -check-expected

# mislabelled on the leaky design: still disproved
setattr -set relpred_pair "copy1.busy copy2.busy" w:relpred_neq.cnt
logger -expect log "ct: disproved" 1
ic3 -init-zero -kind 0 -rel -rel-sym
logger -check-expected

# -rel without predicates is refused
design -load plain
logger -expect error "has no relpred predicates; run `relpred` first" 1
ic3 -init-zero -rel
