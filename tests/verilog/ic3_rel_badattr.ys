# ic3 -rel: a relpred_pair attribute that names no pair of wires is a
# located error, not a silent skip.  Here the value keeps its literal
# quotes, so the names do not resolve (this is what the first RP-2 pin
# set, and the predicate was silently ignored).
read_verilog -sv -formal <<EOT
module acc(input clk, input start, output done);
  reg [3:0] cnt = 0;
  reg busy = 0;
  always @(posedge clk) begin
    if (start && !busy) begin busy <= 1; cnt <= 0; end
    else if (busy) begin
      cnt <= cnt + 1;
      if (cnt == 9) busy <= 0;
    end
  end
  assign done = busy && cnt == 9;
endmodule
module top(input clk, input start);
  wire d1, d2;
  acc copy1(.clk(clk), .start(start), .done(d1));
  acc copy2(.clk(clk), .start(start), .done(d2));
  always @* ct: assert (d1 == d2);
endmodule
EOT
prep -top top
flatten
dffunmap
opt_clean
relpred
select -assert-count 2 a:relpred_pair
setattr -set relpred_pair "\"copy1.busy copy2.busy\"" w:relpred_neq.cnt
logger -expect error "relpred_neq.cnt: relpred_pair .*: the first wire does not exist" 1
ic3 -init-zero -kind 0 -rel
