# constant evaluation
design -reset
read_verilog -sv <<EOT
module i5(output logic [7:0] y, output logic ok);
  function automatic logic [7:0] f(input logic [7:0] a);
    struct packed { logic [3:0] hi; logic [3:0] lo; } v;
    enum logic [1:0] {A, B, C} e;
    v = a;
    e = C;
    return {v.lo, v.hi} + e;
  endfunction
  localparam logic [7:0] K = f(8'h12);
  assign y = K;
  assign ok = y == 8'h23;
endmodule
EOT
prep
sat -prove ok 1 -verify
