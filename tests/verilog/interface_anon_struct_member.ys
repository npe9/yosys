# An interface member with an inline anonymous struct type (`struct packed
# {...} s;').  The member declaration is an AST_STRUCT, not an AST_WIRE, so
# the member wire in a module using the interface was a plain vector and a
# member select through it (`r.s.hi') an implicit wire: degraded.
read_verilog -sv <<EOT
interface rif;
  struct packed { logic [3:0] hi; logic [3:0] lo; } s;
  modport src (output s);
  modport snk (input s);
endinterface
module prod (input logic [7:0] x, rif.src r);
  assign r.s.hi = x[7:4];
  assign r.s.lo = x[3:0];
endmodule
module cons (rif.snk r, output logic [7:0] y, output logic [7:0] z);
  assign y = {r.s.lo, r.s.hi};
  assign z = 8'hff;
endmodule
module top (input logic [7:0] x, output logic [7:0] y, output logic [7:0] z, output logic ok);
  rif i ();
  prod p (.x, .r(i.src));
  cons c (.r(i.snk), .y, .z);
  assign ok = y == {x[3:0], x[7:4]} && z == 8'hff && i.s.hi == x[7:4];
endmodule
EOT
hierarchy -check
hierarchy -top top -check
proc
flatten
opt
select -assert-none =A:sv_degraded
sat -verify -prove ok 1
