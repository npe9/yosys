# `.*' connecting an interface port (IEEE 1800-2017 23.3.2.4; caliptra el2_veer
# passes `regfile' down this way). The wildcard was expanded only after the
# hierarchy loop, so without -top the sub-module was never derived with the
# interface and the connection failed ("No matching wire for implicit port
# connection `r'").
read_verilog -sv <<EOT
interface rif; logic [3:0] a; modport src(output a); modport snk(input a); endinterface
module leaf #(parameter P = 0) (input logic [3:0] x, rif.src r); assign r.a = x ^ P[3:0]; endmodule
module mid #(parameter P = 0) (input logic [3:0] x, rif.src r); leaf #(.P(P)) l(.*); endmodule
module sink(rif.snk r, output logic [3:0] y); assign y = r.a; endmodule
module top(input logic [3:0] x, output logic [3:0] y);
  rif i();
  mid #(.P(0)) m(.x(x), .r(i.src));
  sink s(.r(i.snk), .*);
endmodule
EOT
hierarchy -check
hierarchy -top top -check
proc
flatten
opt
select -assert-none =A:sv_degraded
sat -verify -prove y x
