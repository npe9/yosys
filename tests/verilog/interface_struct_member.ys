# A member select through an interface member of a struct type (caliptra
# el2_regfile_if: `regfile.gpr.rd0`). The type is a typedef from a package the
# interface imports, a typedef local to the interface (nesting the first), or
# a compilation-unit typedef; the interface is a port passed down with `.*`,
# and a local instance. Each member select was an implicit 1-bit wire.
read_verilog -sv <<EOT
package p; typedef struct packed { logic [3:0] rd0; logic [3:0] rd1; } gpr_t; endpackage
typedef struct packed { logic [2:0] a; logic b; } cu_t;
interface rif import p::*; ();
  typedef struct packed { logic [1:0] u; gpr_t g; } loc_t;
  gpr_t gpr; loc_t l; cu_t c;
  modport src(output gpr, output l, output c); modport snk(input gpr, input l, input c);
endinterface
module leaf(input logic [3:0] x, rif.src r);
  assign r.gpr.rd0 = x; assign r.gpr.rd1 = ~x;
  assign r.l.u = x[1:0]; assign r.l.g.rd1 = x + 4'd1; assign r.l.g.rd0 = 4'd0;
  assign r.c.a = x[3:1]; assign r.c.b = x[0];
endmodule
module mid(input logic [3:0] x, rif.src r); leaf l(.*); endmodule
module top(input logic [3:0] x, output logic ok);
  rif i();
  mid m(.x(x), .r(i.src));
  assign ok = i.gpr.rd0 == x && i.gpr.rd1 == ~x && i.l.u == x[1:0] && i.l.g.rd1 == x + 4'd1 &&
    i.l.g.rd0 == 4'd0 && i.l == {x[1:0], 4'd0, x + 4'd1} && {i.c.a, i.c.b} == x && i.gpr == {x, ~x};
endmodule
EOT
hierarchy -top top -check
proc
flatten
opt
select -assert-none =A:sv_degraded
sat -verify -prove ok 1
