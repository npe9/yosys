  ognt_t s_gnt;
  REQ_TYPE req_payload;
  RESP_TYPE resp_payload;
  modport master (output s_req, req_payload, input s_gnt, resp_payload);
  modport monitor (input s_req, req_payload, s_gnt, resp_payload);
endinterface
interface xifc;
  logic v;
endinterface
module fsm(input logic clk, ifc.monitor m);
  p: assert property (@(posedge clk) m.resp_payload.err == m.s_gnt.gnt);
