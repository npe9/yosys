EOT
hierarchy -check -top core
proc
flatten
select -assert-none A:sv_degraded
sva2check
opt_clean
ic3
logger -check-expected

# fe197: the top is replaced twice (reprocessed in the first round, its
# interfaces expanded in the next); `top' moves to the new module each time
# (left on the replaced one, hierarchy could take the module being deleted
# for the top: a use after free on cv32e40s_core, depending on module order)
design -reset
logger -expect log "ic3: 3 properties: proved=2 disproved=1 undecided=0" 1
read_verilog -sv -formal -defer -DRF <<EOT
package pk;
  typedef struct packed { logic req; } oreq_t;
  typedef struct packed { logic gnt; } ognt_t;
  typedef struct packed { logic [3:0] addr; } ireq_t;
  typedef struct packed { logic [7:0] rdata; logic err; } iresp_t;
  typedef struct packed { logic we; logic [3:0] addr; } dreq_t;
  typedef struct packed { logic [7:0] rdata; logic err; logic x; } dresp_t;
endpackage
interface ifc import pk::*; #(parameter type REQ_TYPE = ireq_t, parameter type RESP_TYPE = iresp_t);
