# a property that must fail (the member is driven to 1 through the modport)
design -reset
logger -expect log "ic3: 4 properties: proved=3 disproved=1 undecided=0" 1
read_verilog -sv -formal -DNEG <<EOT
interface xifc;
  logic v;
  logic w;
