# fe199: a module derived for its interface ports is cloned from the module
# that expanded its own local interface instances: with a parameter override
# (the template is never expanded) and, read with -defer, under a top with an
# interface port (the derive came before `$abstract\ifc' was available).
# Before: "Could not find signal '\mi.s_req'" (a struct-typed member).
read_verilog -sv -formal -defer <<EOT
typedef struct packed { logic req; } oreq_t;
interface ifc;
  oreq_t s_req;
  logic g;
  modport master (output s_req, input g);
endinterface
interface xifc;
  logic v;
  logic w;
  modport cpu(output v);
endinterface
module lsu(ifc.master m);
  assign m.s_req.req = 1'b1;
endmodule
module core(input logic clk, input logic gi, xifc.cpu xp, output logic ro);
  ifc mi();
  assign mi.g = gi;
  assign ro = mi.s_req.req;
  assign xp.v = 1'b0;
  lsu l(.m(mi));
  p: assert property (@(posedge clk) mi.s_req.req);
  n: assert property (@(posedge clk) !mi.s_req.req);
endmodule
module top(input logic clk, input logic gi, xifc.cpu xt, output logic ro);
  core core_i(.xp(xt), .*);
endmodule
EOT
hierarchy -check -top top
sva2check
proc
flatten
async2sync
select -assert-none A:sv_degraded
logger -expect log "ic3: 2 properties: proved=1 disproved=1 undecided=0" 1
ic3 -init-zero
logger -check-expected
design -reset

# a parameter override, without -defer
read_verilog -sv -formal <<EOT
typedef struct packed { logic req; } oreq_t;
interface ifc;
  oreq_t s_req;
  logic g;
  modport master (output s_req, input g);
endinterface
interface xifc;
  logic v;
  modport cpu(output v);
endinterface
module lsu(ifc.master m);
  assign m.s_req.req = 1'b1;
endmodule
module core #(parameter int P = 0) (input logic clk, input logic gi, xifc.cpu xp, output logic ro);
  ifc mi();
  assign mi.g = gi;
  assign ro = mi.s_req.req;
  assign xp.v = 1'b0;
  lsu l(.m(mi));
  p: assert property (@(posedge clk) mi.s_req.req);
  n: assert property (@(posedge clk) !mi.s_req.req);
  q: assert property (@(posedge clk) P == 1);
endmodule
module top(input logic clk, input logic gi, xifc.cpu xt, output logic ro);
  core #(.P(1)) core_i(.xp(xt), .*);
endmodule
EOT
hierarchy -check -top top
sva2check
proc
flatten
async2sync
select -assert-none A:sv_degraded
logger -expect log "ic3: 3 properties: proved=2 disproved=1 undecided=0" 1
ic3 -init-zero
logger -check-expected
