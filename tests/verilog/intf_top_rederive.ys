module top (input logic clk, ifc.cpu xp);
  core core_i (.xp(xp), .*);
  logic [3:0] probe;
  assign probe = core_i.cnt;
  p: assert property (@(posedge clk) probe == xp.v);
  n: assert property (@(posedge clk) probe != 4'd3);
endmodule
EOT
hierarchy -check -top top
sva2check
proc
flatten
async2sync
select -assert-none A:sv_degraded
logger -expect log "ic3: 2 properties: proved=1 disproved=1 undecided=0" 1
ic3 -init-zero -bmc 6 -max 0 -kind 2
