# fe117: a package-scope queue variable, class handle, or typedef of either
# (simulation-only, as in UVM's uvm_object_globals.svh / uvm_misc.svh /
# uvm_pool.svh) is dropped instead of refusing the package; the
# package's other members still work, and a module that reads the queue
# still fails (the name no longer resolves)
read_verilog -sv <<EOT
package p;
  typedef enum {A, B} st_t;
  st_t q[$];
  int unsigned qq[$:7];
  class c #(type T = int); T x; endclass
  c h;
  c ha [0:0];
  typedef c #(bit) cb_t;
  cb_t hb;
  typedef int iq_t[$];
  iq_t qv;
  localparam int W = 4;
endpackage
module top(input [p::W-1:0] a, output [p::W-1:0] y);
  assign y = a;
endmodule
EOT
hierarchy -top top
proc
select -assert-count 1 top/a
design -reset
# a bare read through `import p::*' binds the package variable's clone
# (fe119) and so refuses like a qualified read (that case: package_var_import.ys)
logger -expect error "Identifier `\\p::q' is simulation-only package storage" 1
read_verilog -sv <<EOT
package p;
  int q[$];
endpackage
module top3(output int y);
  import p::*;
  assign y = q[0];
endmodule
EOT
hierarchy -top top3
