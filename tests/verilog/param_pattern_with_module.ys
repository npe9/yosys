# The same override with the module read first: the pattern takes the
# parameter's struct type (param_pattern_missing_module.ys is the error).
read_verilog -sv <<EOF
package pp;
  typedef struct packed { logic [3:0] off; logic sec; } info_t;
endpackage
module leaf import pp::*; #(parameter info_t Info = '0) (output [3:0] o, output s);
  assign o = Info.off;
  assign s = Info.sec;
endmodule
module top import pp::*; (output [3:0] o, output s);
  leaf #(.Info('{off: 4'd9, sec: 1'b0})) u (.o(o), .s(s));
endmodule
EOF
hierarchy -top top
proc
flatten
sat -verify -prove o 4'd9 -prove s 1'b0
