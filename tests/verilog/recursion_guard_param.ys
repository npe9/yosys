# fe222: a parameter defined by itself (`parameter P = P + 6', ivtest
# pr3061015a) recursed until the stack overflowed; legal recursion through an
# automatic constant function still elaborates, then the self-reference is a
# clean error.
read_verilog -sv <<EOT
module ok(output [31:0] y);
  function automatic integer fact(input integer n);
    fact = (n <= 1) ? 1 : n * fact(n - 1);
  endfunction
  localparam integer F = fact(10);
  assign y = F;
endmodule
EOT
hierarchy -top ok
proc
sat -verify -prove y 3628800
design -reset
