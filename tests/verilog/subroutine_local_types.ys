# types declared inside a function or task (IEEE 1800-2017 13.3, 13.4)
# 1. a local typedef struct / enum used to reach the caller's block as a
#    statement: an assertion in an unnamed block, a genrtlil abort for an enum
# 2. the same in a constant function: "did not evaluate; using constant 0"
# 3. enum items of a generate block were prefixed twice (\g.g.A)

design -reset
read_verilog -sv <<EOT
module t1(input logic [7:0] x, output logic [7:0] y, output logic ok);
  assign ok = y == {x[3:0], x[7:4]};
  function automatic logic [7:0] f(input logic [7:0] a);
    typedef struct packed { logic [3:0] hi; logic [3:0] lo; } p_t;
    p_t v;
    v = a;
    return {v.lo, v.hi};
  endfunction
  assign y = f(x);
endmodule
EOT
prep
sat -prove ok 1 -verify

design -reset
read_verilog -sv <<EOT
module t3(input logic [7:0] x, output logic [7:0] y, output logic ok);
  assign ok = y == {x[3:0], x[7:4]};
  task automatic g(input logic [7:0] a, output logic [7:0] b);
    typedef struct packed { logic [3:0] hi; logic [3:0] lo; } p_t;
    p_t v;
    v = a;
    b = {v.lo, v.hi};
  endtask
  always_comb g(x, y);
endmodule
EOT
prep
sat -prove ok 1 -verify

design -reset
read_verilog -sv <<EOT
module t5(input logic [7:0] x, output logic [7:0] y, output logic ok);
  assign ok = y == {x[3:0], x[7:4]};
  function automatic logic [7:0] f(input logic [7:0] a);
    typedef struct packed { logic [3:0] hi; logic [3:0] lo; } p_t;
    p_t v;
    v = a;
    return {v.lo, v.hi};
  endfunction
  always_comb begin : nb
    y = f(x);
  end
endmodule
EOT
prep
sat -prove ok 1 -verify

design -reset
read_verilog -sv <<EOT
module t6(input logic [7:0] x, z, output logic [7:0] y, w, output logic ok);
  typedef struct packed { logic [1:0] a; logic [5:0] b; } p_t;
  function automatic logic [7:0] f(input logic [7:0] a);
    typedef struct packed { logic [3:0] hi; logic [3:0] lo; } p_t;
    typedef enum logic [1:0] {A, B, C} e_t;
    p_t v;
    e_t e;
    v = a;
    e = C;
    return {v.lo, v.hi} + e;
  endfunction
  p_t m;
  assign m = x;
  assign y = f(x);
  assign w = f(z) ^ m.b;
  assign ok = y == {x[3:0], x[7:4]} + 8'd2 && w == (({z[3:0], z[7:4]} + 8'd2) ^ x[5:0]);
endmodule
EOT
prep
sat -prove ok 1 -verify

design -reset
read_verilog -sv <<EOT
module t7(input logic clk, input logic [7:0] x, output logic [7:0] y, output logic ok);
  task automatic g(input logic [7:0] a, output logic [7:0] b);
    typedef enum logic [1:0] {S0, S1, S2} st_t;
    st_t s;
    s = a[0] ? S2 : S1;
    b = s;
  endtask
  always_comb g(x, y);
  assign ok = y == (x[0] ? 8'd2 : 8'd1);
endmodule
EOT
prep
sat -prove ok 1 -verify

design -reset
read_verilog -sv <<EOT
module g2(input logic [7:0] x, output logic [7:0] y0, y1, output logic ok);
  for (genvar k = 0; k < 2; k++) begin : f
    typedef enum logic [1:0] {A, B = 2'(k + 1), C} e_t;
    e_t e;
    assign e = C;
  end
  assign y0 = x + f[0].e;
  assign y1 = x + f[1].e;
  assign ok = y0 == x + 8'd2 && y1 == x + 8'd3;
endmodule
EOT
prep
sat -prove ok 1 -verify

# constant evaluation
design -reset
read_verilog -sv <<EOT
module c(output logic [7:0] y, z);
  function automatic logic [7:0] f(input logic [7:0] a);
    typedef struct packed { logic [3:0] hi; logic [3:0] lo; } p_t;
    p_t v;
    v = a;
    return {v.lo, v.hi};
  endfunction
  function automatic logic [7:0] g(input logic [7:0] a);
    typedef enum logic [1:0] {A, B, C} e_t;
    e_t e;
    e = C;
    return a + e;
  endfunction
  localparam logic [7:0] K = f(8'h12);
  localparam logic [7:0] L = g(8'h12);
  assign y = K;
  assign z = L;
endmodule
EOT
prep
sat -prove y 8'h21 -prove z 8'h14 -verify
