hierarchy -top m
proc
sva2check
opt_clean
# a wrong step at either end and on both sides of the middle split is found;
# the right chain has no counterexample within its 211-tick window, at
# either phase of the toggle
logger -expect log "ic3: p_b0: disproved \(depth 211\)" 1
logger -expect log "ic3: p_b104: disproved \(depth 211\)" 1
logger -expect log "ic3: p_b105: disproved \(depth 211\)" 1
logger -expect log "ic3: p_b209: disproved \(depth 211\)" 1
logger -expect log "ic3: p_ok: undecided" 1
ic3 -check-cells -kind 0 -max 0 -bmc 215
logger -check-expected
design -reset

# 1100 steps: the frontend takes it (sva2check's 1024-tick cap is separate)
