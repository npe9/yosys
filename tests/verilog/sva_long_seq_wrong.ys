# fe109: a fixed-length sequence in property position up to 4096 ticks
# lowers (companion of sva_long_seq_cap.ys; caliptra fv_ecc_pm_sequencer inv_modp_a / inv_modq_a: 1041-tick
# microcode walks of `##1` steps).  The cap was 1024 ("sequence ... is N
# ticks long (max 1024)"); it bounds size only: the sequence is a
# register chain, exact at any length, and its deadline past
# long_delay_min goes through the countdown CAM (exact while the
# <name>$overflow twin holds).  A deep BMC over 1100 registers is too
# slow for a test, so `sim -assert` runs the deterministic design: a
# toggle `t`, one attempt at tick 0 (`f`), an 1100-step chain `!t ##1 t
# ...`.

# a wrong step at 1090 fails the main assertion, not the twin
read_verilog -sv -formal <<EOT
module top (input logic clk);
  logic t = 1'b0, f = 1'b1;
  always @(posedge clk) begin t <= !t; f <= 1'b0; end
  p_w1090: assert property (@(posedge clk) f |-> !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !t ##1 t ##1 !