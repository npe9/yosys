# fe131: an unpacked-array assignment with equal unpacked dimensions but a
# different element type is done element by element, left to right, each
# element converted to the target's element type (1800-2017 7.6, as EBMC
# reads it).  It was left unexpanded and C read bits by flattened position
# (hw-cbmc assignment_to_unpacked_array5).
read_verilog -sv <<EOT
module top(input [31:0] x0, x1, x2, input signed [3:0] s);
  int B[0:2];
  byte C[3:1];
  logic [39:0] W[1:3];
  logic signed [3:0] S[0:1];
  int T[0:1];
  always_comb begin
    B[0] = x0; B[1] = x1; B[2] = x2;
    C = B;
    W = B;
    S[0] = s; S[1] = -s;
    T = S;
  end
  always @* begin
    assert (C[3] == x0[7:0]);
    assert (C[2] == x1[7:0]);
    assert (C[1] == x2[7:0]);
    assert (W[1] == {{8{x0[31]}}, x0});   // int is signed
    assert (W[3] == {{8{x2[31]}}, x2});
    assert (T[0] == {{28{s[3]}}, s});
  end
endmodule
EOT
proc
flatten
memory -nomap
memory_map
opt_clean
chformal -lower
sat -verify -prove-asserts -set-def-inputs
