# fe136: a port with two or more unpacked dimensions is flattened in
# row-major, left-to-right element order (1800-2017 7.4.5), leftmost element
# in the MSBs (as fe134 for one dimension).  It used to be left a plain wire
# of the element width, so m[i][j] read out of range (x) with only a warning.
# An index outside its own dimension reads x and a write through it is
# ignored (7.4.6), instead of aliasing another element through the linear
# index.  Values computed by hand; they agree with slang (yosys-slang).
read_verilog -sv <<EOT
module t(input logic [3:0] m [2][3], input logic [1:0] d [3:2][1:0], input logic [1:0] c [2][2][2],
  input logic [1:0] i, input logic j, input logic [1:0] k,
  output logic [3:0] v, output logic [1:0] s, output logic [1:0] dd, output logic [1:0] dv, output logic [1:0] cc,
  output logic [3:0] o [2][2]);
  assign v = m[j][i];
  assign s = m[1][0][2:1];
  assign dd = d[2][1];
  assign dv = d[{1'b1, j}][k[0]];
  assign cc = c[1][0][1];
  always_comb begin
    o[0][0] = 4'h1; o[0][1] = m[0][2]; o[1][0] = {d[3][0], 2'b00}; o[1][1] = 4'h0;
    o[1][1][3] = j;
  end
endmodule
EOT
hierarchy -top t
proc
opt_clean
# m = {1,2,3,4,5,6} left to right: m[1][2] = 6, m[1][0] = 4'b0100
# d [3:2][1:0] = {d[3][1], d[3][0], d[2][1], d[2][0]} = {11, 10, 01, 00}
# c = {11,10,01,00, 11,10,01,00}: c[1][0][1] = 10
sat -verify -set m 24'h123456 -set d 8'b11100100 -set c 16'b1110010011100100 -set i 2 -set j 1 -set k 1 -prove v 4'h6 -prove s 2'b10 -prove dd 2'b01 -prove dv 2'b11 -prove cc 2'b10 -prove o 16'h1388
design -reset
read_verilog -sv <<EOT
module r(input logic [3:0] m [2][3], input logic [1:0] i, input logic j, output logic [3:0] v, output logic [3:0] o [2][3]);
  assign v = m[j][i];
  always_comb begin
    for (int a = 0; a < 2; a++) for (int b = 0; b < 3; b++) o[a][b] = 4'h0;
    o[j][i] = 4'hf;
  end
endmodule
EOT
hierarchy -top r
proc
opt_clean
# m[0][3] is out of range: x (not m[1][0] = 4), and the write is dropped
sat -verify -enable_undef -set-def-inputs -set m 24'h123456 -set i 3 -set j 0 -prove v 4'bxxxx -prove o 24'h0
sat -verify -enable_undef -set-def-inputs -set m 24'h123456 -set i 2 -set j 0 -prove v 4'h3 -prove o 24'h00f000
design -reset
read_verilog -sv <<EOT
package p; typedef logic [3:0] nib_t; endpackage
module y(input p::nib_t n [2][3], output logic [3:0] nv);
  assign nv = n[1][1];
endmodule
EOT
hierarchy -top y
proc
sat -verify -set n 24'h123456 -prove nv 4'h5
design -reset
# a slice of an unpacked dimension is refused, not read as a wrong word
logger -expect error "Slice or part-select of an unpacked dimension of the multi-dimensional unpacked port `m' is not supported" 1
read_verilog -sv <<EOT
module s(input logic [3:0] m [2][3], output logic [11:0] row);
  assign row = m[1];
endmodule
EOT
