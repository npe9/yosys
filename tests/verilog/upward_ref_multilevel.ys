# a written upward reference is not forwarded (it would drive the target a second time)
read_verilog -sv -formal <<EOT
module w(input logic clk);
  assign u_a.x = 1'b1;
endmodule
module mid(input logic clk);
  w ww(.clk(clk));
endmodule
module a(input logic clk, output logic x);
  assign x = 1'b0;
endmodule
module chk(input logic clk, input logic v);
  p: assert property (@(posedge clk) v == 1'b0);
endmodule
module top(input logic clk);
  a u_a(.clk(clk), .x());
  mid m(.clk(clk));
  chk k(.clk(clk), .v(u_a.x));
endmodule
EOT
hierarchy -top top
proc
flatten
select -assert-any A:sv_degraded
design -reset

# an interface port bus without gnt: bus.gnt is not looked up further (a parent's bus.gnt)
read_verilog -sv -formal <<EOT
interface ifc; logic req; endinterface
module chk(input logic clk, input logic v);
  p: assert property (@(posedge clk) v == 1'b1);
endmodule
module sub(input logic clk, ifc bus);
  chk k(.clk(clk), .v(bus.gnt));
endmodule
module g(input logic clk, output logic gnt);
  assign gnt = 1'b1;
endmodule
module top(input logic clk);
  ifc i0();
  g bus(.clk(clk), .gnt());
  sub s(.clk(clk), .bus(i0));
endmodule
EOT
hierarchy -top top
proc
flatten
select -assert-any A:sv_degraded
design -reset
